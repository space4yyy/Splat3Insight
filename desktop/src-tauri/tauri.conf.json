{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splat 3 Streaming Widget",
  "version": "0.1.0",
  "identifier": "com.splat3.streaming-widget",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Splat 3 Streaming Widget",
        "width": 560,
        "height": 680,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.local; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  },
  "plugins": {}
}
