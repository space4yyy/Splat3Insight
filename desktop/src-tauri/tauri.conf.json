{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splat3StreamingWidget",
  "version": "0.1.0",
  "identifier": "ink.space4.splat3streamingwidget",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Splat3StreamingWidget",
        "width": 560,
        "height": 680,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.local; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
