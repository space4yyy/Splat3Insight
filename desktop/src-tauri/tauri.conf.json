{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splat3 Insight",
  "version": "0.1.0",
  "identifier": "ink.space4.Splat3Insight",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Splat3 Insight",
        "width": 1240,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "visible": false,
        "resizable": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src http://127.0.0.1:17353; img-src 'self' http://127.0.0.1:17353 splat3img: http://splat3img.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
